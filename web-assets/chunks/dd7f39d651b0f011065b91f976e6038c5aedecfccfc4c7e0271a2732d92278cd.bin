  "scope": "D2PRL activation allocation and transport lifecycle. No mathematical kernel or precision change. These component tests are not a new complete learned-model or96MP qualification.",
  "failure": {
    "run": "runtime-v2-owned-readback-96mp-20261003T052054Z",
    "operation": "feature:copy:affine",
    "requestedBytes": 102760448,
    "observed": "Native output already computed in Wasm; an ordinary ArrayBuffer copy failed despite policy budget headroom."
  },
  "implementation": {
    "storage": "Shared data-only WebAssembly.Memory banks, fixed initial=maximum;16MiB amortized minimum and page-rounded useful extent for large tensors. Allocations coalesce returned ranges; no growth of a published backing.",
    "integration": [
      "feature-math",
      "neural-math",
      "DLF",
      "preparation",
      "UNet Concat",
      "union input",
      "descriptor banks",
      "CPU convolution output"
    ],
    "copy": "Native helpers copy their exact output bytes into reusable Wasm data banks; this retains one Wasm-to-Wasm copy, rather than exposing mutable compute heaps. Fully overwritten outputs opt out of redundant zero fill.",
    "lifetime": "Per-tensor getter and idempotent release; bank ownership and accounting survive engine dispose until the final live slice releases. Idle banks reclaimable; no policy budget or CPU ceiling reduced.",
    "transport": "Owned Wasm inputs are sent to CPU/evaluator workers in <=1MiB dedicated transferable windows, batched up to8MiB per ACK; no whole-bank structured clone.",
    "publicBoundary": "Raw model output/readRaw remain dedicated ordinary arrays of3*448*448*4 bytes, so no arena bank reaches the public worker transferable collector.",
    "ledger": "Arena banks and actual feature/neural/DLF/preparation heap extents, GPU buffers and mapped GPU extents are registered separately from budget reservations. Worker-local CPU/evaluator heaps, network staging and browser internals are not comprehensively represented by these registrations; this is not RSS."
  },
