import "../../runtime-context.js?v=0.30.0";
// Reclaimable, borrowed native SSG scalar stages.
import {allocateOwnedTypedArray} from './allocation.js';
import {requireValue,checkAbort} from './errors.js';
import {sourceRegionTransportBytes} from './source-region-transport.js';
const sha=v=>typeof v==='string'&&/^[a-f0-9]{64}$/.test(v);
function base(i){requireValue(i&&[i.sourceSha256,i.contextFingerprint,i.candidateFingerprint].every(sha)&&Number.isSafeInteger(i.sourceRevision)&&i.sourceRevision>=0&&typeof i.checkpointKey==='string'&&i.checkpointKey.length>0&&Number.isSafeInteger(i.width)&&i.width>0&&Number.isSafeInteger(i.height)&&i.height>0&&Number.isSafeInteger(i.width*i.height),'Exact SSG source/checkpoint/grid identity required');return[i.sourceSha256,i.contextFingerprint,i.candidateFingerprint,i.sourceRevision,i.checkpointKey,i.width,i.height];}
export function ssgMapKey(i){const b=base(i);requireValue(Number.isFinite(i.sigma)&&i.sigma>0&&Number.isSafeInteger(i.groupIndex)&&i.groupIndex>=0&&Array.isArray(i.matrix)&&i.matrix.length===6&&i.matrix.every(Number.isFinite),'Exact SSG sigma/transform/group identity required');return JSON.stringify(['ssim/1',b,i.sigma,i.groupIndex,i.matrix]);}
export function ssgRoiKey(i){const b=base(i);requireValue(Number.isFinite(i.salienceSigma)&&i.salienceSigma>0&&Number.isSafeInteger(i.roiRadius)&&i.roiRadius>=0&&i.roiRadius<=512,'Exact SSG ROI native identity required');return JSON.stringify(['roi/1',b,i.salienceSigma,i.roiRadius]);}
export function createStageCache(budget){const entries=new Map(),life=new AbortController();let closed=false,active=false,done=Promise.resolve();
 const destroy=e=>{if(e.cached||e.readers||e.closed)return;e.closed=true;for(const o of e.owners)o.release();e.owners.length=0;e.values=e.valid=null;e.meta();},evict=e=>{if(entries.get(e.key)===e)entries.delete(e.key);e.cached=false;destroy(e);},reclaim=()=>{const n=budget.total();for(const e of [...entries.values()])if(!e.readers)evict(e);return n-budget.total();},unregister=budget.registerReclaimer?.(reclaim,{owner:'private-native-ssg-localization',allocationKind:'array-buffer'});
 async function prepare(kind,i,fill,{signal}={}){requireValue(!closed&&!active&&typeof fill==='function'&&['roi','ssim'].includes(kind),'Native stage cache closed or busy');const key=kind==='roi'?ssgRoiKey(i):ssgMapKey(i),n=i.width*i.height;requireValue(Number.isSafeInteger(n*(kind==='roi'?8:18)),'SSG stage byte size overflow');const combined=signal?AbortSignal.any([signal,life.signal]):life.signal;checkAbort(combined);active=true;let finish;done=new Promise(r=>finish=r);let meta,owners=[];
   try{meta=budget.reserve(4096+key.length*6);const own=(Type,len,label)=>{const o=allocateOwnedTypedArray(Type,len,{budget,owner:'private-native-ssg-localization',label});owners.push(o);return o.data;};const values=own(Float64Array,n*(kind==='roi'?1:2),kind==='roi'?'exact common native ROI':'two exact SSIM directions'),valid=kind==='ssim'?own(Uint8Array,n*2,'two native support fields'):null;await fill({values,valid,signal:combined});checkAbort(combined);const entry={key,width:i.width,height:i.height,kind,values,valid,owners,meta,readers:0,cached:true,closed:false};owners=[];meta=null;const old=entries.get(key);entries.set(key,entry);if(old){old.cached=false;destroy(old);}budget.notifyReclaimable?.();return key;}
   finally{try{for(const o of owners)o.release();meta?.();}finally{active=false;finish();}}
  }
 return{has:key=>!closed&&entries.has(key),borrowAll(keys){requireValue(Array.isArray(keys)&&new Set(keys).size===keys.length,'Distinct native stage keys required');if(closed||keys.some(k=>!entries.has(k)))return null;const held=keys.map(k=>entries.get(k));for(const e of held)e.readers++;let ended=false;return{stages:held.map(e=>({key:e.key,values:e.values,valid:e.valid,width:e.width,height:e.height,kind:e.kind})),release(){if(ended)return;ended=true;for(const e of held){e.readers--;destroy(e);}}};},
  async prepare(kind,i,fill,{signal}={}){const identityBytes=sourceRegionTransportBytes(i,{allowAliases:true,allowUndefined:true});const identityCredit=budget.reserve(identityBytes*6+65536);try{return await prepare(kind,i,fill,{signal});}finally{identityCredit();}},
  disposeIdle(){requireValue(!active,'Cannot retire active SSG stages.');closed=true;life.abort();try{for(const e of [...entries.values()])evict(e);}finally{unregister?.();}},
reclaim,clear(){for(const e of [...entries.values()])evict(e);},async dispose(){closed=true;life.abort();await done;try{for(const e of [...entries.values()])evict(e);}finally{unregister?.();}}
 };
}
