export async function dlfStudy(module,reference,read,{onCase=()=>{}}={}){
 const records=[];
 for(const row of reference.records){const input=await read(row.input),weights=await read(row.weights),errors=new Float32Array((await read(row.errors)).buffer),scores=new Float32Array((await read(row.scores)).buffer),n=row.side**2,ip=module._malloc(input.byteLength),wp=module._malloc(weights.byteLength),op=module._malloc(n*8);if(!ip||!wp||!op)throw Error('DLF allocation');
  try{module.HEAPU8.set(input,ip);module.HEAPU8.set(weights,wp);const start=performance.now();for(let at=0;at<n;at+=256)if(module._d2prl_dlf_range(ip,ip+n*4,wp,row.side,row.kernel,at,Math.min(n,at+256),op,op+n*4)!==1)throw Error('DLF range');const output=module.HEAPF32.slice(op/4,op/4+n*2),raw=output.subarray(0,n),actual=output.subarray(n),rawBits=new Uint32Array(raw.buffer,raw.byteOffset,n),expectedRawBits=new Uint32Array(errors.buffer),scoreBits=new Uint32Array(actual.buffer,actual.byteOffset,n),expectedScoreBits=new Uint32Array(scores.buffer);let rawDifferent=0,scoreDifferent=0,maxRawError=0,maxScoreError=0,nonfinite=0;for(let i=0;i<n;i++){rawDifferent+=rawBits[i]!==expectedRawBits[i];scoreDifferent+=scoreBits[i]!==expectedScoreBits[i];maxRawError=Math.max(maxRawError,Math.abs(raw[i]-errors[i]));maxScoreError=Math.max(maxScoreError,Math.abs(actual[i]-scores[i]));nonfinite+=!Number.isFinite(raw[i])||!Number.isFinite(actual[i]);}const record={name:row.name,rawDifferent,scoreDifferent,maxRawError,maxScoreError,nonfinite,functionalMs:performance.now()-start};records.push(record);onCase(record);
  }finally{module._free(op);module._free(wp);module._free(ip);}
 }
 return{schema:1,status:records.every(r=>!r.rawDifferent&&!r.scoreDifferent&&!r.nonfinite)?'passed':'rejected',scope:reference.scope,cases:records.length,records};
}
