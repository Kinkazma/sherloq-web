let block=id.x+id.y*p.groupsX*32u;if(block>=arrayLength(&variance)){return;}
let channel=block/p.plane;let point=block%p.plane;let cols=p.width-6u;
let first=byte(((point/cols)*p.width+point%cols)*3u+channel);var sameBytes=true;for(var dy=0u;dy<7u&&sameBytes;dy++){for(var dx=0u;dx<7u&&sameBytes;dx++){sameBytes=byte(((point/cols+dy)*p.width+point%cols+dx)*3u+channel)==first;}}if(sameBytes){variance[block]=0.0;rejected[block]=first+2u;return;}
