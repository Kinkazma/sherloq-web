import "../../runtime-context.js?v=0.30.0";
import{compileOriginalSourceRegions}from'./source-region-geometry.js';
import{EngineError,requireValue,checkAbort}from'./errors.js';
import{retireCompositeOwners}from'./composite-owner-release.js';
const rect=(x0,y0,x1,y1)=>[[x0,y0],[x1,y0],[x1,y1],[x0,y1]],digest=async value=>[...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(JSON.stringify(value))))].map(n=>n.toString(16).padStart(2,'0')).join('');
// One canonical analysis window, never a union of neighbouring acquisitions.
// The owner is returned/captured before domain validation or RGB can await.
export function createSegmentationWindowSource({original,window},{budget,signal,onOwner}={}){
 requireValue(original?.segmented&&original.surface?.descriptor&&window&&budget?.reserve,'Original RGB surface and one canonical analysis window required');
 const loans=new Set(),pending=new Map(),reads=new Set(),credit=budget.reserve(2*1024**2);let closing=false,closed=false,disposal,plan;
 const releaseLoan=loan=>{if(!loans.has(loan))return;if(pending.has(loan))return pending.get(loan);const task=Promise.resolve().then(()=>loan.release()).then(()=>loans.delete(loan));pending.set(loan,task);void task.finally(()=>pending.delete(loan)).catch(()=>{});return task;};
 const checkpoint=async()=>{await Promise.allSettled([...reads]);await retireCompositeOwners([...loans].map(loan=>()=>releaseLoan(loan)));};
 const owner={releaseCheckpoint:checkpoint,async dispose(){if(disposal)return disposal;if(closed)return;closing=true;disposal=(async()=>{await Promise.allSettled([owner.ready]);await Promise.allSettled([...reads]);await retireCompositeOwners([...loans].map(loan=>()=>releaseLoan(loan)));closed=true;credit();})().finally(()=>disposal=undefined);return disposal;},get plan(){return plan;},get image(){return plan?.image;}};onOwner?.(owner);
 owner.ready=Promise.resolve().then(async()=>{
  checkAbort(signal);requireValue(!closing,'Window source retired');const c=await compileOriginalSourceRegions(window.contextDomain.descriptor??window.contextDomain),a=await compileOriginalSourceRegions(window.candidateDomain.descriptor??window.candidateDomain),d=original.surface.descriptor;
  requireValue(c.sourceSha256===original.sha256&&a.sourceSha256===original.sha256&&c.sourceWidth===d.width&&c.sourceHeight===d.height&&a.sourceWidth===d.width&&a.sourceHeight===d.height&&typeof window.fingerprint==='string'&&['region','envelope'].includes(window.kind),'Canonical window domains differ from Original');
  const b=window.bounds;requireValue(Array.isArray(b)&&b.length===4&&b.every(Number.isFinite)&&b[0]>=0&&b[1]>=0&&b[2]<=d.width&&b[3]<=d.height&&b[2]>b[0]&&b[3]>b[1],'Native analysis window bounds');
  if(a.empty||c.empty){const identity=await digest(['native-segmentation-window/1',original.sha256,window.fingerprint,c.fingerprint,a.fingerprint,'empty']);checkAbort(signal);requireValue(!closing,'Window source retired during validation');plan={id:window.id,kind:window.kind,status:'empty',bounds:[...b],frame:null,width:0,height:0,fragmented:false,contextDomain:c,candidateDomain:a,identity,observations:{rgbReadCalls:0,rgbObservedPixels:0,rgbForbiddenPixels:0}};return plan;}
  const frame=[c.rect.x0,c.rect.y0,c.rect.x1,c.rect.y1],width=frame[2]-frame[0],height=frame[3]-frame[1];requireValue(frame[0]+.5>=b[0]-1e-9&&frame[1]+.5>=b[1]-1e-9&&frame[2]-.5<=b[2]+1e-9&&frame[3]-.5<=b[3]+1e-9,'Window context escapes its own analysis bounds');
  requireValue(a.empty||a.rect&&a.rect.x0>=frame[0]&&a.rect.y0>=frame[1]&&a.rect.x1<=frame[2]&&a.rect.y1<=frame[3],'Window candidates escape their own RGB frame');
  const fragmented=!c.empty&&c.countIncluded!==width*height,observations={rgbReadCalls:0,rgbObservedPixels:0,rgbForbiddenPixels:0},surface={descriptor:{...d,id:d.id+':window:'+window.fingerprint,width,height,sourceWidth:d.width,sourceHeight:d.height},readWindow(r,options={}){
   requireValue(!closing&&plan&&!fragmented,'Literal window reader is unavailable for fragmented context');requireValue([r.x,r.y,r.width,r.height].every(Number.isSafeInteger)&&r.x>=0&&r.y>=0&&r.width>0&&r.height>0&&r.x+r.width<=width&&r.y+r.height<=height,'Native cropped RGB read bounds');const x=r.x+frame[0],y=r.y+frame[1];
   for(let row=y;row<y+r.height;row++){const xs=c.originalRowIntervals(row);if(!xs.some(([lo,hi])=>x>=lo&&x+r.width<=hi)){observations.rgbForbiddenPixels+=r.width;throw new EngineError('SOURCE_SCOPE_UNADMITTED_READ','Native CNN requested RGB outside this one window');}}
   const task=Promise.resolve().then(async()=>{checkAbort(signal);checkAbort(options.signal);const loan=await original.surface.readWindow({...r,x,y},options);loans.add(loan);observations.rgbReadCalls++;observations.rgbObservedPixels+=r.width*r.height;return{get pixels(){return loan.pixels},release(){return releaseLoan(loan)}};});reads.add(task);void task.finally(()=>reads.delete(task)).catch(()=>{});return task;
  }};
  // Reuse the native scientific-scope membership contract. It restricts native
  // candidates; it never paints CNN input. Context negatives were checked above.
  const rectangles=[],active=new Map();
  for(let y=0;y<height;y++){checkAbort(signal);const next=new Map();for(const[lo,hi]of a.originalRowIntervals(y+frame[1])){const left=Math.max(lo,frame[0])-frame[0],right=Math.min(hi,frame[2])-frame[0];if(right<=left)continue;const key=left+','+right,old=active.get(key);if(old&&old[3]===y){old[3]=y+1;next.set(key,old);active.delete(key);}else next.set(key,[left,y,right,y+1]);}for(const value of active.values())rectangles.push(value);active.clear();for(const[key,value]of next)active.set(key,value);if(rectangles.length+active.size>8192)throw new EngineError('SOURCE_SCOPE_METADATA_LIMIT','Exact per-window candidate membership exceeds native metadata bound');}rectangles.push(...active.values());
  const fingerprint=await digest(['native-segmentation-window/1',original.sha256,window.fingerprint,c.fingerprint,a.fingerprint,frame]),scientificScope={schema:'sherloq.scientific-scope/1',coordinates:'original-pixels',sourceSha256:original.sha256,width,height,status:a.empty?'excluded':'ready',regions:a.empty?[]:[{id:window.id,kind:'region',x0:0,y0:0,x1:width,y1:height,polygon:rect(0,0,width,height)}],excluded:[],fingerprint,...(!a.empty?{nativeSourceRegions:{schema:'sherloq.native-region-membership/1',coordinates:'source-region-native',domainFingerprint:a.fingerprint,sourceSha256:original.sha256,width,height,levels:[{rectangles}]}}:{})};
  checkAbort(signal);requireValue(!closing,'Window source retired during validation');plan={id:window.id,kind:window.kind,bounds:[...b],frame,width,height,fragmented,contextDomain:c,candidateDomain:a,identity:fingerprint,scientificScope,observations,image:{segmented:true,retireBorrowedRows:checkpoint,sha256:original.sha256,surface,session:original.session,ensureTemporarySession:original.ensureTemporarySession,provenance:{...structuredClone(original.provenance),analysisWindow:{id:window.id,kind:window.kind,originalBounds:[...b],nativeInputBounds:frame,contextFingerprint:c.fingerprint,candidateFingerprint:a.fingerprint,independent:true}}}};return plan;
 });void owner.ready.catch(()=>{});return owner;
}
