  const start=(y-top)*ctx.w,end=start+count*ctx.w;await low.write(masks[0].data.subarray(start,end),y*ctx.w,{signal:ctx.signal});await high.write(masks[1].data.subarray(start,end),y*ctx.w,{signal:ctx.signal});
  if(!filtered){const display=allocateOwnedTypedArray(Uint8Array,count*ctx.w*3,{budget:ctx.budget,owner:'native16-extrema',label:'extrema-palette-band'});work.push(display);for(let i=start;i<end;i++)if(masks[0].data[i]||masks[1].data[i])display.data.set(MINMAX_PALETTE[masks[0].data[i]?p.minimum:p.maximum],(i-start)*3);await output.write(display.data,y*ctx.w*3,{signal:ctx.signal});}blocks++;progress(ctx,(filtered?.5:1)*(y+count)/ctx.h);
 }catch(error){bandFailed=true;bandPrimary=error;throw error;}finally{await retireCompositeOwners([...work.map(owner=>()=>owner.release()),()=>part.release()],bandFailed?{primary:bandPrimary,requireAck:true}:{requireAck:true});}}
 await low.flush();await high.flush();
 if(filtered){
  // All allocations below are covered by the reserved compact-cell allowance.
  const counts=[new Uint16Array(cells),new Uint16Array(cells)];grids.push(...counts);const countRows=Math.min(ctx.h,Math.max(1,Math.floor(Math.min(STAGING,available(ctx))/(ctx.w*2))));
  for(let y=0;y<ctx.h;y+=countRows){await ctx.cooperate();const count=Math.min(countRows,ctx.h-y),a=allocateOwnedTypedArray(Uint8Array,count*ctx.w,{budget:ctx.budget,owner:'native16-extrema',label:'density-minimum-band'});let b;try{b=allocateOwnedTypedArray(Uint8Array,count*ctx.w,{budget:ctx.budget,owner:'native16-extrema',label:'density-maximum-band'});await low.readInto(a.data,y*ctx.w,{signal:ctx.signal});await high.readInto(b.data,y*ctx.w,{signal:ctx.signal});for(let row=0;row<count;row++){if(row%32===0)await ctx.cooperate();const base=Math.floor((y+row)/block)*columns;for(let x=0;x<ctx.w;x++){const cell=base+Math.floor(x/block),i=row*ctx.w+x;counts[0][cell]+=a.data[i];counts[1][cell]+=b.data[i];}}progress(ctx,.5+.2*(y+count)/ctx.h);}finally{a.release();b?.release();}}
  const values=new Float32Array(cells),levels=[];grids.push(values);
  for(const count of counts){values.fill(0);if(ctx.w>radius&&ctx.h>radius)for(let cy=0;cy<cellRows;cy++){if(cy%32===0)await ctx.cooperate();const bh=Math.min(block,ctx.h-cy*block);for(let cx=0;cx<columns;cx++){const bw=Math.min(block,ctx.w-cx*block),i=cy*columns+cx;if(bw<=radius||bh<=radius)continue;const q=count[i]/(bw*bh);values[i]=Math.sqrt(q*(1-q));}}levels.push(normalizeU8(values,127));}
  const combined=new Uint8Array(cells*3),colors=[p.minimum,p.maximum];for(let i=0;i<cells;i++)for(let m=0;m<2;m++)for(let c=0;c<3;c++)if(colors[m]===c||colors[m]===3)combined[i*3+c]+=levels[m][i];const normalized=normalizeU8(combined);grids.push(...levels,combined,normalized);progress(ctx,.75);
  const renderRows=bandRows(ctx,3),display=allocateOwnedTypedArray(Uint8Array,renderRows*ctx.w*3,{budget:ctx.budget,owner:'native16-extrema',label:'density-display-band'});try{for(let y=0;y<ctx.h;y+=renderRows){await ctx.cooperate();const count=Math.min(renderRows,ctx.h-y);for(let row=0;row<count;row++){if(row%32===0)await ctx.cooperate();const base=Math.floor((y+row)/block)*columns;for(let x=0;x<ctx.w;x++){const cell=(base+Math.floor(x/block))*3,to=(row*ctx.w+x)*3;display.data[to]=normalized[cell];display.data[to+1]=normalized[cell+1];display.data[to+2]=normalized[cell+2];}}await output.write(display.data.subarray(0,count*ctx.w*3),y*ctx.w*3,{signal:ctx.signal});progress(ctx,.75+.25*(y+count)/ctx.h);}}finally{display.release();}
 }
 await output.flush();checkAbort(ctx.signal);return outputRecord(ctx,output,{minimum:low,maximum:high},{semantics:'Strict extrema of exact uint16 samples; squared RGB norm uses float64 to preserve all integer values. Compact density display keeps the complete-image normalization and never changes raw masks.',metrics:{blocks,rowsPerBlock:rows,inputDepth:16,storage:output.storage,maskStorage:{minimum:low.storage,maximum:high.storage},densityCells:filtered?cells:0,retainedResultBytes:ctx.n*5}});
 }catch(error){await retireAll([low,high,output],{primary:error});throw error;}finally{grids.length=0;gridReservation?.();planning?.();}}

/** Source ownership is borrowed. Result arrays/surfaces own their buffers and
 * must be disposed by the caller. Unsupported tools return null for the root
 * registry to retain their declared legacy path, not a backend rejection. */
export async function runNative16Operation(operation,params={},options={}){
 if(!native16ParametersAdmitted(operation,params))return null;const {surface,budget,signal}=options,d=surface?.descriptor;requireValue(d?.format==='rgb16'&&d.depth===16&&typeof surface.readWindow==='function'&&budget,'A budgeted native RGB16 surface is required.');requireValue(options.rowsPerBlock===undefined||Number.isSafeInteger(options.rowsPerBlock)&&options.rowsPerBlock>0,'Invalid native16 working row group.');requireValue(options.parameterUnits===undefined||['ui8','native'].includes(options.parameterUnits),'Invalid native16 parameter units.');checkAbort(signal);
 if(operation==='inspection.adjust')requireValue(options.parameterUnits===undefined||options.parameterUnits==='ui8','Adjustment controls use historical UI units.');
 const ctx=await prepareNative16DomainContext(operation,params,{storage:'auto',...options,operation,w:d.width,h:d.height,n:d.width*d.height,cooperate:createCooperator(signal)});
 const executeBase=(input,context)=>NATIVE16_TRANSFORMS.includes(operation)?runNative16Transform(operation,context.surface,input,context):({'inspection.adjust':(ctx,input)=>segmentedNative16Adjust({surface:ctx.surface,session:ctx.temporarySession,ensureTemporarySession:ctx.getTemporarySession},native16AdjustParams(input),ctx),'inspection.magnifier':(ctx,input)=>runNative16Magnifier(ctx.surface,input,ctx),'inspection.histogram':nativeHistogram,'colors.stats':nativeStats,'noise.planes':nativePlanes,'noise.minmax':nativeMinmax,'detail.echo':(ctx,input)=>runNative16Echo(ctx.surface,input,ctx),'detail.gradient':(ctx,input)=>runNative16Gradient(ctx.surface,input,ctx),'noise.separation':(ctx,input)=>runNative16Separation(ctx.surface,input,ctx),'pixels.defects':(ctx,input)=>runNative16Defects(ctx.surface,input,ctx),'colors.space':(ctx,input)=>nativeColorSpaces(ctx.surface,input,ctx),'colors.pca':(ctx,input)=>segmentedPca({surface:ctx.surface,session:ctx.temporarySession,ensureTemporarySession:ctx.getTemporarySession},input,ctx)}[operation])(context,input);
 let record;
 try{record=await runNative16EqualizedRecord(operation,params,ctx,executeBase);return await finishNative16DomainRecord(operation,params,ctx,record);}catch(error){if(record)await retireCompositeOwners([()=>record.dispose?record.dispose():record.surface?.dispose()],{primary:error,requireAck:true});const normalized=normalizeResourceError(error);throw normalized!==error&&error?.cleanupOwner?withRetirementOwner(normalized,error.cleanupOwner,error):normalized;}
}
