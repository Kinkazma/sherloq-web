const f=Math.fround;
export function cfaPairwiseSum(a,start=0,n=a.length){if(n<8){let s=f(-0);for(let i=0;i<n;i++)s=f(s+a[start+i]);return s;}if(n<=128){const r=Array.from(a.slice(start,start+8));let i=8;for(;i+7<n;i+=8)for(let j=0;j<8;j++)r[j]=f(r[j]+a[start+i+j]);let s=f(f(f(r[0]+r[1])+f(r[2]+r[3]))+f(f(r[4]+r[5])+f(r[6]+r[7])));for(;i<n;i++)s=f(s+a[start+i]);return s;}let cut=Math.floor(n/2);cut-=cut%8;return f(cfaPairwiseSum(a,start,cut)+cfaPairwiseSum(a,start+cut,n-cut));}
 export function cfaPostprocess(prob,n){const grids=new Float32Array(4*n),means=new Float32Array(4),local=new Uint8Array(n),suspicion=new Float32Array(n);for(let k=0;k<4;k++){for(let i=0;i<n;i++){let s=0;for(let c=0;c<4;c++)s=f(s+prob[((k^c)*4+c)*n+i]);grids[k*n+i]=f(s/4);}means[k]=f(cfaPairwiseSum(grids,k*n,n)/n);}let best=0;for(let k=1;k<4;k++)if(means[k]>means[best])best=k;for(let i=0;i<n;i++){let k=0;for(let c=1;c<4;c++)if(grids[c*n+i]>grids[k*n+i])k=c;local[i]=k;const confidence=k===best?1:Math.max(0,Math.min(1,f(1-grids[k*n+i])));suspicion[i]=f(1-confidence);}return {grids,means,best,local,suspicion};}
