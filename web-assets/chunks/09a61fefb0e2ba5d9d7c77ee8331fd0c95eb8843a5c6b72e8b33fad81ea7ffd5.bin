  return{id:task.id,imageId:task.imageId,operation:task.operation,status:'ok',layout:'surface',...bundle,display:bundle.surface,data,semantics,metrics,layers:[{id:task.operation,kind:'rgb',surfaceId:bundle.surface.id,origin:[0,0],coordinates:'source'},...fragments.map(f=>({id:f.id,kind:'rgb',surfaceId:bundle.rgbSurfaces[f.id].id,origin:f.bounds.slice(0,2),coordinates:'independent-native-context',blockPhase:f.blockPhase}))],provenance:{params:p,backend:'cpu',sourceRegionDomain:domain.descriptor,sourceRegionOrigin:[...domain.origin],excludedParticipation:'absent-before-native-context-histogram-derivatives-and-cell-median',nativePadding:'unchanged native zero padding and extra indicator row/column in each complete context',originalEncodedBytesPreserved:true}};
