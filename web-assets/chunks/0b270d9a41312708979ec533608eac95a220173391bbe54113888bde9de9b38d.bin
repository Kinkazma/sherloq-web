import "../../runtime-context.js?v=0.25.0";
import {checkAbort} from './errors.js';
/** FOCAL/AdaIFL and SAFIRE are qualified by this registration. Their M3 owner
 * enforces strict native fragments before preprocessing or any model call. SAFIRE clusters
 * all native fragment descriptors globally after extraction. */
export const SOURCE_REGION_RESEARCH_ADAPTER=Object.freeze({shapes:Object.freeze(['membership','native-regions']),previewOperations:Object.freeze(['ai.sources.safire']),run:({task,runLegacy,signal})=>{checkAbort(signal);return runLegacy(task);}});
