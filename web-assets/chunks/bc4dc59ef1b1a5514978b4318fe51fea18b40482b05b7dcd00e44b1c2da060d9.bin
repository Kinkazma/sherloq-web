import {allocateOwnedTypedArray} from '../../src/allocation.js';
import {requireValue,checkAbort,controlCheckpoint} from '../../src/errors.js';
import {requireStrictFragmentPlan} from './strict-fragment-plan.js';
import {createStrictFragmentEvaluatorPool} from './strict-fragment-evaluator-pool.js';
import {runStrictFragmentPatchMatch} from './strict-fragment-patchmatch.js';
import {runStrictSingleFragmentPatchMatch} from './strict-single-fragment-patchmatch.js';
import {runStrictFragmentRoles} from './strict-fragment-roles.js';
async function readPatchMatch(bank,id,signal,SIDE=448){const N=SIDE*SIDE;const leases=[],pm={offsets:{zm:{},cnn:{}},coordinates:{zm:{},cnn:{}}};try{for(const [category,prefix]of[['offsets','off'],['coordinates','pm']])for(const branch of['zm','cnn'])for(const axis of['x','y']){const lease=await bank.read(id,prefix+':'+branch+':'+axis,{signal});leases.push(lease);requireValue(lease.dtype==='float32'&&lease.data.length===N,'Strict native PatchMatch bank grid differs.');pm[category][branch][axis]=lease.data;}return{pm,release(){for(const lease of leases)lease.release();}};}catch(error){for(const lease of leases)lease.release();throw error;}}
async function candidateMask(plan,owner,domain,{budget,signal}){const SIDE=plan.modelSide??448,N=SIDE*SIDE;const mask=allocateOwnedTypedArray(Uint8Array,N,{budget,owner:'d2prl',label:'strict-fragment-candidate-statistics'});let done=false,count=0,stamp=performance.now();try{for(let i=0;i<N;i++){const p=plan.toOriginal(owner,i%SIDE,Math.floor(i/SIDE));if(domain.containsOriginal(Math.floor(p[0]+.5),Math.floor(p[1]+.5))){mask.data[i]=1;count++;}if((i&8191)===0){checkAbort(signal);if(performance.now()-stamp>=8){await controlCheckpoint(signal);stamp=performance.now();}}}done=true;return{data:mask.data,count,release:mask.release};}finally{if(!done)mask.release();}}
/** Entire native model over genuine RGB fragments. All preparation/CNN/UNet,
 * original40-iteration matching and original role nodes are used. The passed
 * bank is caller-owned and retains completed immutable stages for a verified
 * resource retry; this function never republishes a partial failed tensor. */
export async function runStrictFragmentModel({plan,bank,candidateDomain,preparation,descriptors,unionHead,unet,math,roles,convolution,randomState,evaluatorUrl,nativeEvaluatorUrl,nativeDescriptorLayout,operation,maxWorkers,gpuFactories,arithmetic='cpu',randomFactory,candidateFactory},{budget,signal,onProgress,checkpointKey}={}){
 requireStrictFragmentPlan(plan);const SIDE=plan.modelSide??448,N=SIDE*SIDE;requireValue(candidateDomain?.sourceSha256===plan.sourceSha256&&candidateDomain.sourceWidth===plan.sourceWidth&&candidateDomain.sourceHeight===plan.sourceHeight&&typeof candidateDomain.containsOriginal==='function'&&Number.isSafeInteger(maxWorkers)&&maxWorkers>=1&&maxWorkers<=64&&typeof evaluatorUrl==='string','Verified candidate membership and unchanged native model stages are required.');checkAbort(signal);let evaluator;const phaseTimes={},decisions=[],admittedGridCentres=[];
 const phase=async(name,work)=>{const started=performance.now();try{return await work();}finally{phaseTimes[name]=(phaseTimes[name]??0)+performance.now()-started;}},progress=(owner,stage,event={})=>{checkAbort(signal);onProgress?.({...event,phase:'strict-fragment-'+stage,fragmentId:owner.id,fragmentIndex:owner.index,fragments:plan.fragments.length});checkAbort(signal);};
 try{
  for(const owner of plan.fragments){let rgb,features,prepared;const key=checkpointKey?checkpointKey+':'+plan.fingerprint+':'+owner.id:undefined;
   let failed=false,primary;try{if(!bank.has(owner.index,'rgb')){progress(owner,'preparation');const input=plan.input(owner.index);prepared=await phase('preparation',()=>preparation.runRows(input,{signal,onProgress:event=>progress(owner,'preparation',event)}));await bank.publish(owner.index,'rgb',{data:prepared.data,dtype:'float32',shape:[1,3,SIDE,SIDE]},{signal});}
    if(!bank.has(owner.index,'zm')||!bank.has(owner.index,'cnn')){rgb=prepared??await bank.read(owner.index,'rgb',{signal});progress(owner,'descriptors');features=await phase('descriptors',()=>descriptors.run(rgb.data,{signal,checkpointKey:key,onStage:name=>progress(owner,'descriptors',{message:name})}));for(const [name,channels]of[['zm',36],['cnn',96]])if(!bank.has(owner.index,name)){if(features.schema==='sherloq.d2prl-paged-descriptor-banks/1')features.transferField(name,tensor=>bank.adoptPaged(owner.index,name,tensor));else await bank.publish(owner.index,name,{data:features[name],dtype:'float16',shape:[1,channels,SIDE,SIDE]},{signal});}}
   }catch(error){failed=true;primary=error;throw error;}finally{let cleanupFailed=false,cleanupPrimary;for(const release of [()=>features?.release(),()=>rgb!==prepared?rgb?.release():undefined,()=>prepared?.release()])try{const value=await release();if(value===0||value===false)throw value;}catch(error){if(!cleanupFailed){cleanupFailed=true;cleanupPrimary=error;}}if(cleanupFailed){if(!failed)throw cleanupPrimary;if(primary&&typeof primary==='object'&&Object.isExtensible(primary))try{primary.details={...primary.details,descriptorCleanup:cleanupPrimary};}catch{}}}
  }
  convolution.releaseIdleWorkers?.();
  const nativeSingle=plan.fragments.length===1&&plan.fragments[0].bounds.every((v,i)=>v===plan.bounds[i]);let nativePoolStats;const matchingExecutions=[];if(!nativeSingle){const foreignCapacity=gpuFactories?.strict?Math.min(plan.fragments.length-1,Math.max(0,Math.floor((budget.limit-budget.total())/(3*264*N)))):plan.fragments.length===2?1:0;evaluator=gpuFactories?.strict?await gpuFactories.strict({budget,operation,arithmetic,residentForeignLimit:foreignCapacity}):createStrictFragmentEvaluatorPool(evaluatorUrl,{budget,maxWorkers,tileSize:512,residentForeignLimit:foreignCapacity});}
  const candidateAdmits=(x,y)=>candidateDomain.containsOriginal(Math.floor(x+.5),Math.floor(y+.5));
  for(const owner of plan.fragments){if(['off','pm'].every(prefix=>['zm','cnn'].every(branch=>['x','y'].every(axis=>bank.has(owner.index,prefix+':'+branch+':'+axis))))){matchingExecutions.push({fragmentId:owner.id,reusedCompletedBank:true});continue;}let matched;try{progress(owner,'patchmatch');matched=await phase('patchmatch',()=>nativeSingle?runStrictSingleFragmentPatchMatch(plan,bank,{candidateDomain,nativeEvaluatorUrl,nativeDescriptorLayout,maxWorkers,operation,randomFactory,candidateFactory,evaluatorFactory:gpuFactories?.normal,iterationFactory:gpuFactories?.iteration,randomState,side:SIDE,iterations:40,referenceThreads:8},{budget,signal,checkpointKey,onProgress:event=>progress(owner,'patchmatch',event)}):runStrictFragmentPatchMatch(plan,bank,evaluator,{fragment:owner,randomState,randomFactory,candidateFactory,side:SIDE,iterations:40,referenceThreads:8,candidateAdmits},{budget,signal,onProgress:event=>progress(owner,'patchmatch',event)}));nativePoolStats=matched.execution?.pool??nativePoolStats;matchingExecutions.push(matched.execution);for(const [category,prefix]of[['offsets','off'],['coordinates','pm']])for(const branch of['zm','cnn'])for(const axis of['x','y']){const name=prefix+':'+branch+':'+axis;if(!bank.has(owner.index,name))await bank.publish(owner.index,name,{data:matched[category][branch][axis],dtype:'float32',shape:[1,1,SIDE,SIDE]},{signal});}}finally{matched?.release();}}
  const matchingPool=nativeSingle?{path:gpuFactories?.normal?'gpu-single-context-rectangle':'unchanged-native-single-context-rectangle',...(nativePoolStats??{reusedCompletedBank:true})}:evaluator.stats;await evaluator?.dispose();evaluator=null;
  for(const owner of plan.fragments){if(bank.has(owner.index,'union')&&bank.has(owner.index,'union-decision')){const cached=await bank.read(owner.index,'union-decision',{signal});try{requireValue(cached.data.length===4,'Strict union decision metadata differs.');decisions.push({fragmentId:owner.id,overlap:cached.data[0],threshold:cached.data[1],combineMaximum:cached.data[2]===1});admittedGridCentres.push({fragmentId:owner.id,admitted:cached.data[3],total:N});}finally{cached.release();}continue;}let pm,rgb,dedicated,general,product,overlap,total,mask,maskedProduct,maskedGeneral,combined;try{progress(owner,'union');pm=await readPatchMatch(bank,owner.index,signal,SIDE);dedicated=await phase('union-head',()=>unionHead.run(pm.pm,{signal,checkpointKey:checkpointKey?checkpointKey+':union:'+owner.id:undefined,onStage:name=>progress(owner,'union',{message:name})}));if(SIDE>=1344&&budget.limit<=2*1024**3){pm.release();pm=null;}rgb=await bank.read(owner.index,'rgb',{signal});general=await phase('unet',()=>unet.run(rgb.data,{signal,checkpointKey:checkpointKey?checkpointKey+':unet:'+owner.id:undefined,onNode:({index,total})=>progress(owner,'unet',{completed:index+1,total})}));product=await math.run('Mul',[dedicated,general],{},{signal});mask=await candidateMask(plan,owner,candidateDomain,{budget,signal});admittedGridCentres.push({fragmentId:owner.id,admitted:mask.count,total:N});let p=product,g=general;
    // Only the reduction operands are masked, after genuine unmasked RGB CNN
    // inference on admitted context fragments. Excluded candidate pixels make
    // no contribution to overlap/threshold statistics; no RGB is black-filled.
    if(mask.count!==N){maskedProduct=allocateOwnedTypedArray(Float32Array,N,{budget,owner:'d2prl',label:'strict-union-product-statistics'});maskedGeneral=allocateOwnedTypedArray(Float32Array,N,{budget,owner:'d2prl',label:'strict-union-general-statistics'});for(let i=0;i<N;i++)if(mask.data[i]){maskedProduct.data[i]=product.data[i];maskedGeneral.data[i]=general.data[i];}p={data:maskedProduct.data,shape:[1,1,SIDE,SIDE]};g={data:maskedGeneral.data,shape:[1,1,SIDE,SIDE]};}
    overlap=await math.run('SumAll',[p],{referenceThreads:8},{signal});total=await math.run('SumAll',[g],{referenceThreads:8},{signal});const decision={overlap:overlap.data[0],threshold:Math.fround(total.data[0]*.5)};decision.combineMaximum=decision.overlap>decision.threshold;combined=decision.combineMaximum?await math.run('Max',[dedicated,general],{},{signal}):dedicated;decisions.push({fragmentId:owner.id,...decision});if(!bank.has(owner.index,'union-decision'))await bank.publish(owner.index,'union-decision',{data:Float32Array.of(decision.overlap,decision.threshold,decision.combineMaximum?1:0,mask.count),dtype:'float32',shape:[1,4,1,1]},{signal});if(!bank.has(owner.index,'union'))await bank.publish(owner.index,'union',{data:combined.data,dtype:'float32',shape:[1,1,SIDE,SIDE]},{signal});
   }finally{if(combined!==dedicated)combined?.release();maskedGeneral?.release();maskedProduct?.release();mask?.release();total?.release();overlap?.release();product?.release();general?.release();dedicated?.release();rgb?.release();pm?.release();}}
  convolution.releaseIdleWorkers?.();const roleExecution=await phase('roles',()=>runStrictFragmentRoles(plan,bank,roles,{budget,signal,onProgress}));checkAbort(signal);return{schema:'sherloq.d2prl-strict-fragment-model/1',arithmetic,modelSide:SIDE,iterations:40,referenceThreads:8,fragments:plan.fragments.map(owner=>({id:owner.id,bounds:[...owner.originalBounds],nativeInputGrid:[owner.width,owner.height],modelGrid:[SIDE,SIDE]})),phaseTimingSemantics:'Current invocation wall milliseconds; already published bank stages are reused and skipped, not assigned fabricated recompute time.',candidateFingerprint:candidateDomain.fingerprint,contextFingerprint:plan.domainFingerprint,phaseTimes,decisions,admittedGridCentres,matchingPool,matchingExecutions,roles:roleExecution,semantics:'Genuine separate RGB CNN fragments, real cross-fragment descriptor/role banks, unchanged weights/native grids; no fabricated RGB hole and no claim of inter-shape bit identity.'};
 }finally{try{await evaluator?.dispose();}finally{convolution.releaseIdleWorkers?.();}}
}
