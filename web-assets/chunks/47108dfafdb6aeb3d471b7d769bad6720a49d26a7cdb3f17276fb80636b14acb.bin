// Error-only historical replay. Candidate mathematics and Philox fill are the
// existing functions; the SAME MPS scorer is called once for each old stage.
import{nonlocalOffsets,searchBounds,randomCandidates,propagateOffsets,wrapOffsets,createCandidateWorkspace}from'./candidates.js';
import{fillNativeMpsSource}from'./iteration-random-mps.js';
import{requireValue,checkAbort,normalizeResourceError}from'../../src/errors.js';
import{preserveConvolutionPrimary}from'./convolution-retirement.js';
const SIDE=448,N=SIDE*SIDE;
const steps=final=>final?[['zm','random'],['cnn','random'],['cnn','propagate']]:[['zm','random'],['cnn','random'],['zm','propagate'],['zm','propagate'],['cnn','propagate']];
export async function replayIteration({budget,adoptOwner,engine,schedule,pairs,initialBounds,previousNonlocal,output,final=false,referenceThreads=8,signal,adoptGpuRetirement}={}){
 requireValue(budget?.reserve&&typeof adoptOwner==='function'&&typeof adoptGpuRetirement==='function'&&engine?.scoreCpuCandidates&&schedule?.active,'Owned exact historical iteration replay required');
 const life=new AbortController(),selected=signal?AbortSignal.any([signal,life.signal]):life.signal,values=new Set();let finishWork;const workDone=new Promise(r=>finishWork=r);let fee,geometry,retired=false,closing,primary,failed=false;
 const owner={dispose(){if(retired)return Promise.resolve();if(closing)return closing;life.abort();const task=(async()=>{await workDone;geometry?.dispose();geometry=null;let bad=false,error;for(const record of[...values])try{await record.backing?.();values.delete(record);record.value=null;}catch(e){if(!bad){bad=true;error=e;}}if(bad)throw error;await fee?.();fee=null;retired=true;})();closing=task;void task.finally(()=>{if(closing===task)closing=null;}).catch(()=>{});return task;}};
 const allocate=(Type,count,label)=>{const record={value:null,backing:null};values.add(record);try{record.value=new Type(count);}catch(error){throw normalizeResourceError(error,{requestedBytes:count*Type.BYTES_PER_ELEMENT,allocationKind:'array-buffer'});}record.backing=budget.registerBacking?.('array-buffer',record.value.byteLength,{owner:'d2prl',label,identity:record.value.buffer});return record.value;};
 try{adoptOwner(owner);checkAbort(selected);fee=budget.reserve(192*N+32*SIDE+8192);requireValue(output instanceof Float32Array&&output.length===4*N,'Complete caller-owned replay output');
  const candidatePlanes=[allocate(Float32Array,13*N,'iteration-replay-candidates'),allocate(Float32Array,13*N,'iteration-replay-candidates')],noise=allocate(Float32Array,2*N,'iteration-replay-noise'),nonlocal=allocate(Float32Array,4*N,'iteration-replay-nonlocal'),boundsPool=allocate(Float32Array,8*N,'iteration-replay-bounds'),state=allocate(Float32Array,4*N,'iteration-replay-selected');
  geometry=createCandidateWorkspace(SIDE);const g=geometry.geometry(SIDE);for(const a of[...g.columns,...g.rows]){const record={value:a,backing:null};values.add(record);record.backing=budget.registerBacking?.('array-buffer',a.byteLength,{owner:'d2prl',label:'iteration-replay-geometry',identity:a.buffer});}
  const hooks={signal:selected},source=metadata=>{let cursor=0;return{async values(count){requireValue(cursor<metadata.length,'Native replay source call count');const item=metadata[cursor++],destination=count===2*N?noise:noise.subarray((cursor-1)*N,cursor*N);requireValue(count===item.count&&destination.length===count,'Native replay source shape');await fillNativeMpsSource({counter:item.counter,key:item.key,output:destination},{signal:selected});return destination;}};};
  let current={zm:pairs.zm,cnn:pairs.cnn},windows=initialBounds;
  if(previousNonlocal){windows={};for(const[b,branch]of['zm','cnn'].entries()){let slot=0;const meta=previousNonlocal[b],dual=meta.counters.map(counter=>({counter,key:meta.key,count:N}));current[branch]=await nonlocalOffsets(current[branch],SIDE,source(dual),{signal:selected,allocate:count=>{requireValue(count===N&&slot<2,'Historical nonlocal extent');const start=(2*b+slot++)*N;return nonlocal.subarray(start,start+N);}});slot=0;windows[branch]=await searchBounds(current[branch],SIDE,{signal:selected,allocate:count=>{requireValue(count===N&&slot<4,'Historical bounds extent');const start=(4*b+slot++)*N;return boundsPool.subarray(start,start+N);}});}}
  requireValue(windows?.zm&&windows?.cnn,'Literal initial/current bounds required');let randomIndex=0;
  for(const[branch,kind]of steps(final)){checkAbort(selected);let cursor=0;const candidateHooks={signal:selected,allocate:count=>{requireValue(cursor<2&&count<=13*N,'Historical candidate extent');return candidatePlanes[cursor++].subarray(0,count);},geometry:()=>g};const item=schedule.sources[randomIndex],random=kind==='random'?source([{counter:item.counter,key:schedule.key,count:item.count}]):null;if(kind==='random')randomIndex++;
   const candidate=await(kind==='random'?randomCandidates(current[branch],windows[branch],SIDE,random,candidateHooks):propagateOffsets(current[branch],SIDE,candidateHooks));await wrapOffsets(candidate,SIDE,{signal:selected,inPlace:true});const b=branch==='zm'?0:1,target=state.subarray(2*b*N,(2*b+2)*N);await engine.scoreCpuCandidates({branch,offsetX:candidate.x,offsetY:candidate.y,candidates:kind==='random'?5:13,output:target,referenceThreads},{signal:selected,adoptGpuRetirement});current[branch]={x:target.subarray(0,N),y:target.subarray(N)};
  }
  checkAbort(selected);output.set(current.zm.x,0);output.set(current.zm.y,N);output.set(current.cnn.x,2*N);output.set(current.cnn.y,3*N);return output;
 }catch(error){failed=true;primary=error;throw error;}finally{finishWork();try{await owner.dispose();}catch(cleanup){if(failed)preserveConvolutionPrimary(primary,cleanup);else throw cleanup;}}
}
