        "experiments/projection-pixel-forest-native.hpp",
        "experiments/target-memory-exact-tape.hpp",
        "experiments/target-memory-packing-neighbors.hpp",
        "experiments/target-memory-local-neighbors.hpp",
        "experiments/target-memory-ic0.hpp",
        "experiments/target-memory-mass-palette.hpp"
      ],
      "buildScript": "experiments/target-memory-ringcert-build.sh",
      "proofScript": "experiments/target-memory-ringcert-proof.py",
      "loader": "experiments/target-memory-ringcert-kernel.mjs",
      "wasm": "experiments/target-memory-ringcert-kernel.wasm",
      "disassembly": "experiments/target-memory-ringcert-kernel.wat",
      "proofJson": "experiments/target-memory-ringcert-growth-proof.json",
      "proofModule": "experiments/target-memory-ringcert-growth-proof.mjs"
    },
    {
      "name": "ringcert-general",
