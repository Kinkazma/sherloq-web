import "../../runtime-context.js?v=0.30.0";
import{requireValue,checkAbort,createCooperator,EngineError}from'./errors.js';
import{createZeroRetirement as createRetirement}from'./zero-native-context-plan.js';
import{allocateTypedArray}from'./allocation.js';import{sourceRegionTransportBytes}from'./source-region-transport.js';
export const DCT_DOMAIN_VERSION='original-stored-dct-complete-blocks/1';
export function encodedToDisplayed(x,y,width,height,orientation){switch(orientation){case 2:return[width-1-x,y];case 3:return[width-1-x,height-1-y];case 4:return[x,height-1-y];case 5:return[y,x];case 6:return[height-1-y,x];case 7:return[height-1-y,width-1-x];case 8:return[y,width-1-x];default:return[x,y];}}
function displayedToEncoded(x,y,width,height,orientation){switch(orientation){case 2:return[width-1-x,y];case 3:return[width-1-x,height-1-y];case 4:return[x,height-1-y];case 5:return[y,x];case 6:return[y,height-1-x];case 7:return[width-1-y,height-1-x];case 8:return[width-1-y,x];default:return[x,y];}}
function intersection(a,b){const out=[];for(let i=0,j=0;i<a.length&&j<b.length;){const x=Math.max(a[i][0],b[j][0]),y=Math.min(a[i][1],b[j][1]);if(y>x)out.push([x,y]);if(a[i][1]<b[j][1])i++;else j++;}return out;}
export async function createDctBlockPlan({width,height,orientation=1,sourceSha256,domain,budget,signal,onOwner}={}){
 checkAbort(signal);requireValue([width,height].every(n=>Number.isInteger(n)&&n>=1&&n<=65535)&&Number.isInteger(orientation)&&orientation>=1&&orientation<=8,'Invalid original JPEG block geometry.');const displayWidth=orientation>=5?height:width,displayHeight=orientation>=5?width:height,columns=Math.floor(width/8),rows=Math.floor(height/8),blocks=columns*rows,whole=!domain||domain.countIncluded===displayWidth*displayHeight&&domain.origin[0]===0&&domain.origin[1]===0&&domain.width===displayWidth&&domain.height===displayHeight;
 if(domain)requireValue(domain.sourceSha256===sourceSha256&&domain.sourceWidth===displayWidth&&domain.sourceHeight===displayHeight&&typeof domain.originalRowIntervals==='function','Original JPEG evidence and displayed source domain differ.');
 const owner=createRetirement({signal});let finish;owner.waitUntil(new Promise(r=>finish=r));let data=null,backing,fee,scratch,selected=whole?blocks:0;
 owner.add(()=>{data=null;},0);owner.add(async()=>{const bytes=await backing?.();backing=null;if(bytes!==0&&fee)budget.notifyBackingRelease?.('array-buffer',bytes??Math.ceil(blocks/32)*4);},1);owner.add(async()=>{await fee?.();fee=null;},2);owner.add(async()=>{await scratch?.();scratch=null;},2);
 try{onOwner?.(owner);checkAbort(owner.signal);if(!whole){checkAbort(owner.signal);scratch=budget.reserve(65536+(domain?sourceRegionTransportBytes(domain.descriptor??domain.snapshot??{}, {allowAliases:true})*4:0));fee=budget.reserve(Math.ceil(blocks/32)*4);data=allocateTypedArray(Uint32Array,Math.ceil(blocks/32),{label:'JPEG admitted stored-block bitset'});backing=budget.registerBacking?.('array-buffer',data.byteLength,{owner:'double-jpeg',label:'original-DCT-membership',identity:data.buffer});
  if(blocks){const points=[[0,0],[columns*8-1,0],[0,rows*8-1],[columns*8-1,rows*8-1]].map(([x,y])=>encodedToDisplayed(x,y,width,height,orientation)),left=Math.min(...points.map(p=>p[0])),top=Math.min(...points.map(p=>p[1])),visualColumns=orientation>=5?rows:columns,visualRows=orientation>=5?columns:rows,cooperate=createCooperator(owner.signal);
   for(let by=0;by<visualRows;by++){await cooperate();checkAbort(owner.signal);const y=top+by*8;let allowed=domain.originalRowIntervals(y);for(let dy=1;dy<8&&allowed.length;dy++)allowed=intersection(allowed,domain.originalRowIntervals(y+dy));for(const[a,b]of allowed){const first=Math.max(0,Math.ceil((a-left)/8)),end=Math.min(visualColumns,Math.floor((b-left)/8));for(let bx=first;bx<end;bx++){const[ex,ey]=displayedToEncoded(left+bx*8,y,width,height,orientation),index=Math.floor(ey/8)*columns+Math.floor(ex/8),word=index>>>5,bit=1<<(index&31);if(!(data[word]&bit)){data[word]|=bit;selected++;}}}}
  }checkAbort(owner.signal);await scratch();scratch=null;}
  return{version:DCT_DOMAIN_VERSION,width,height,orientation,columns,rows,totalBlocks:blocks,includedBlocks:selected,whole,sourceSha256,domainFingerprint:domain?.fingerprint??null,get mask(){if(owner.state.closing||owner.state.closed)throw new EngineError('DISPOSED','JPEG block plan is retiring.');return data;},dispose:()=>owner.dispose()};
 }catch(primary){finish();try{await owner.dispose();}catch{}throw primary;}finally{finish();}
}
