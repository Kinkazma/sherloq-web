import "../../runtime-context.js?v=0.14.5";
import {requireValue} from './errors.js';
export const SIFT_SOURCE = 'SIFT + G2NN + RANSAC + Panels + Text';
export const CLASSICAL_SOURCES = Object.freeze(['PatchMatch Zernike', 'PatchMatch SIFT', SIFT_SOURCE]);
export const AI_SOURCES = Object.freeze(['Forgeryscope Auto', 'D2PRL']);
export const CLONE_SOURCES = Object.freeze(['Forgeryscope Auto', ...CLASSICAL_SOURCES, 'D2PRL']);
export const ELA_SOURCE = 'ELA biomes';
export const sourceLabel = source => source === SIFT_SOURCE ? 'SIFT + G2NN + RANSAC' : source;
// NumPy rint: ties to even, including negative half-integers.
export function roundEven(x) {const f = Math.floor(x), d = x - f; return d < .5 ? f : d > .5 ? f + 1 : f % 2 ? f + 1 : f;}
export function polygon(value) {
  requireValue(Array.isArray(value) && value.length >= 3 && value.every(p => Array.isArray(p) && p.length === 2 && p.every(Number.isFinite)), 'Finite source-coordinate polygon required');
  return value.map(p => p.map(Math.fround));
}
export function polygonArea(p) {let area = 0; for (let i = 0, j = p.length - 1; i < p.length; j = i++) area += p[j][0] * p[i][1] - p[i][0] * p[j][1]; return Math.abs(area) / 2;}
// Canonical ring preserves edges, including concave lassos. Cyclic shifts and
// reverse traversal are equivalent; arbitrary vertex permutations are not.
export function polygonRing(p){
 requireValue(Array.isArray(p)&&p.every(q=>Array.isArray(q)&&q.length===2&&q.every(Number.isFinite)),'Finite polygon ring required');
 const points=[];for(const q of p){const a=q.map(x=>roundEven(x*1000)/1000||0),last=points.at(-1);if(!last||a[0]!==last[0]||a[1]!==last[1])points.push(a);}
 if(points.length>1&&points[0][0]===points.at(-1)[0]&&points[0][1]===points.at(-1)[1])points.pop();
 const compare=(a,b)=>a[0]-b[0]||a[1]-b[1];
 const minimum=values=>{const n=values.length;if(!n)return [];let i=0,j=1,k=0;while(i<n&&j<n&&k<n){const c=compare(values[(i+k)%n],values[(j+k)%n]);if(!c){k++;continue;}if(c>0){i+=k+1;if(i===j)i++;}else{j+=k+1;if(i===j)j++;}k=0;}const start=Math.min(i,j);return values.slice(start).concat(values.slice(0,start));};
 const a=minimum(points),b=minimum(points.slice().reverse());for(let i=0;i<a.length;i++){const c=compare(a[i],b[i]);if(c)return c<0?a:b;}return a;
}
// Browser context equality uses the canonical ring directly.
// Explicit detector search_context values take precedence; native SHA identifiers
// remain valid opaque identities and need not be regenerated by the browser.
export function polygonKey(p) {return JSON.stringify(polygonRing(p));}
export function signedDistance(p, point) {
  const [x,y] = point; let inside = false, distance = Infinity;
  for (let i=0,j=p.length-1;i<p.length;j=i++) {
    const [ax,ay]=p[j],[bx,by]=p[i],dx=bx-ax,dy=by-ay,t=Math.max(0,Math.min(1,((x-ax)*dx+(y-ay)*dy)/(dx*dx+dy*dy)||0));
    distance=Math.min(distance,Math.hypot(x-ax-t*dx,y-ay-t*dy));
    if ((ay>y)!==(by>y) && x < (bx-ax)*(y-ay)/(by-ay)+ax) inside=!inside;
  }
  return distance===0 ? 0 : inside ? distance : -distance;
}
export function panels(regions, envelope=null) {
  const values=regions.map((p,i)=>[i,polygon(p)]);
  if(values.length<=1)return values;
  if(envelope){const key=polygonKey(envelope);return values.filter(([,p])=>polygonKey(p)!==key);}
  const largest=values.reduce((a,b)=>polygonArea(a[1])>=polygonArea(b[1])?a:b);
  return values.every(([,p])=>p.every(q=>signedDistance(largest[1],q)>=0)) ? values.filter(v=>v!==largest) : values;
}
export function pairRelations({points,pairs,regions=[]}) {
  const zones=panels(regions).sort((a,b)=>polygonArea(a[1])-polygonArea(b[1]));
  const memberships=points.map(p=>zones.filter(([,z])=>signedDistance(z,p.slice(0,2))>=0).map(([i])=>i));
  return pairs.map(([a,b])=>{requireValue(Number.isInteger(a)&&Number.isInteger(b)&&a>=0&&b>=0&&a<points.length&&b<points.length,'Invalid point-pair indices');const left=memberships[a],right=memberships[b],shared=left.find(i=>right.includes(i));return shared===undefined?[left[0]??-1,right[0]??-1].sort((x,y)=>x-y):[shared,shared];});
}
export function annotateRelations(entries, {regions=[],envelope=null,width,height}) {
  requireValue(Number.isInteger(width)&&Number.isInteger(height)&&width>0&&height>0,'Source dimensions required');
  let zones=panels(regions,envelope).sort((a,b)=>polygonArea(a[1])-polygonArea(b[1]));
  if(!zones.length)zones=[[0,[[0,0],[width-1,0],[width-1,height-1],[0,height-1]]]];
  const keys=regions.map(polygonKey),envelopeKey=envelope&&polygonKey(envelope);
  return entries.map(entry=>{
    if(!CLONE_SOURCES.includes(entry.source)||entry.pixel_mask)return entry;
    const polygons=entry.polygons.map(polygon),owners=polygons.map(p=>zones.filter(([,z])=>p.every(q=>signedDistance(z,q)>=-.75)).map(([i])=>i));
    const common=zones.find(([i])=>owners.length&&owners.every(ids=>ids.includes(i)));
    const assigned=common?owners.map(()=>common[0]):owners.map(ids=>ids[0]??null);
    const relation=common?'within':owners.length===2&&owners.every(ids=>ids.length)?'between':'unassigned';
    const origin=entry.provenance?.search_region,originKey=origin&&polygonKey(origin),context=entry.search_context||entry.provenance?.search_context||(origin?'roi:'+originKey:'unspecified');
    const searchIndex=origin?keys.indexOf(originKey):-1;
    return {...entry,relation,endpoint_zones:assigned,search_context:context,heat_eligible:true,
      search_label:searchIndex>=0?'Zone '+(searchIndex+1):AI_SOURCES.includes(entry.source)?'Enclosing zone':context==='whole-image'?'Whole image':'Unspecified search',
      from_enclosing_search:Boolean(regions.length>1&&envelopeKey&&originKey===envelopeKey),
      biome_fill_alpha:polygons.map((p,k)=>AI_SOURCES.includes(entry.source)?.25:.25/(1+2*Math.sqrt(Math.min(1,polygonArea(p)/Math.max(1,zones.find(([i])=>i===assigned[k])?.[1] ? polygonArea(zones.find(([i])=>i===assigned[k])[1]) : width*height)))))};
  });
}
export function visibleCloneEntries(entries,{source=null,hidden=[],focused=null,relation='all',enabledSources=CLONE_SOURCES,presentation='biomes'}={}) {
  requireValue(['within','between','all'].includes(relation)&&['biomes','map','overlay'].includes(presentation),'Invalid clone presentation');
  const excluded=new Set(hidden),enabled=new Set(enabledSources);
  return entries.filter(e=>(!source||e.source===source)&&!excluded.has(e.id)&&(!focused||e.id===focused)&&
    (e.source===ELA_SOURCE?presentation==='biomes':enabled.has(e.source))&&
    (!CLASSICAL_SOURCES.includes(e.source)||relation==='all'||e.relation===relation));
}
export function biomePaintOrder(entries) {return entries.slice().sort((a,b)=>b.polygons.reduce((s,p)=>s+polygonArea(p),0)-a.polygons.reduce((s,p)=>s+polygonArea(p),0));}
