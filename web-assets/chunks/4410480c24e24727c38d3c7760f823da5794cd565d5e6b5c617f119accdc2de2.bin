import "../../runtime-context.js?v=0.30.0";
// Native ordered IDWT and original cropped RGB8 conversion.
export const waveletResidentUpShader="\nfn a32(a:f32,b:f32)->f32{return fma(1.0,a,b);}\nfn s32(a:f32,b:f32)->f32{return fma(-1.0,b,a);}\nfn twoSum(a:f32,b:f32)->vec2<f32>{let s=a32(a,b);let v=s32(s,a);let e=a32(s32(a,s32(s,v)),s32(b,v));return vec2<f32>(s,e);}\nfn ddAdd(a:vec2<f32>,b:vec2<f32>)->vec2<f32>{let s=twoSum(a.x,b.x);return twoSum(s.x,a32(s.y,a32(a.y,b.y)));}\nfn ddMul(a:vec2<f32>,b:vec2<f32>)->vec2<f32>{let p=a.x*b.x;var e=fma(a.x,b.x,-p);e=fma(a.x,b.y,e);e=fma(a.y,b.x,e);e=fma(a.y,b.y,e);return twoSum(p,e);}\n@group(0) @binding(0) var<storage,read> rawInput:array<vec2<u32>>;\n@group(0) @binding(1) var<storage,read> bank:array<vec2<f32>>;\n@group(0) @binding(2) var<storage,read_write> output:array<vec2<f32>>;\nstruct Params{width:u32,height:u32,ow:u32,oh:u32,f:u32,axis:u32,groupsX:u32,pad:u32};\n@group(0) @binding(3) var<uniform> p:Params;\nfn at(axisIndex:u32,line:u32)->u32{return select(line*p.width+axisIndex,axisIndex*p.width+line,p.axis==0u);}\n\nfn sample(axisIndex:u32,line:u32,band:u32)->vec2<f32>{\n let bits=rawInput[at(axisIndex,line)+band*p.width*p.height];if((p.pad&1u)!=0u){return bitcast<vec2<f32>>(bits);}let magnitude=bits.y&2147483647u;if(magnitude==0u&&bits.x==0u){return vec2<f32>(bitcast<f32>(bits.y&2147483648u),0.0);}\n let e=i32(magnitude>>20u)-1023;let top=(((magnitude&1048575u)|1048576u)<<3u)|(bits.x>>29u);let bottom=bits.x&536870911u;\n let sign=select(1.0,-1.0,(bits.y&2147483648u)!=0u);let hi=ldexp(f32(top),e-23);let lo=ldexp(f32(bottom),e-52);return twoSum(sign*hi,sign*lo);\n}\n\n@compute @workgroup_size(128) fn up(@builtin(global_invocation_id) id:vec3<u32>){\n let index=id.x+id.y*p.groupsX*128u;if(index>=p.ow*p.oh){return;}\n let line=select(index/p.ow,index%p.ow,p.axis==0u);let position=select(index%p.ow,index/p.ow,p.axis==0u);\n let i=position/2u+p.f/2u-1u;let parity=position%2u;var lo=vec2<f32>(0.0);var hi=vec2<f32>(0.0);\n for(var j=0u;j<p.f/2u;j++){let k=j*2u+parity;lo=ddAdd(lo,ddMul(bank[2u*p.f+k],sample(i-j,line,0u)));hi=ddAdd(hi,ddMul(bank[3u*p.f+k],sample(i-j,line,1u)));}\n output[index+(p.pad>>1u)]=ddAdd(lo,hi);\n}\n";
export const waveletResidentRgbShader="\n@group(0) @binding(0) var<storage,read> input:array<vec2<f32>>;\n@group(0) @binding(1) var<storage,read_write> output:array<u32>;\n@group(0) @binding(2) var<storage,read_write> invalid:atomic<u32>;\nstruct Params{width:u32,height:u32,targetWidth:u32,targetHeight:u32,groupsX:u32,pad:u32,pad2:u32,pad3:u32};\n@group(0) @binding(3) var<uniform> p:Params;\nfn byte(value:vec2<f32>)->u32{\n if(!(abs(value.x)<1048576.0&&abs(value.y)<1.0)){atomicOr(&invalid,1u);return 0u;}\n let hi=trunc(value.x);let fraction=fma(1.0,value.y,value.x-hi);var integral=i32(hi);\n if(integral>0&&fraction<0.0){integral--;}\n else if(integral<0&&fraction>0.0){integral++;}\n return bitcast<u32>(integral)&255u;\n}\n@compute @workgroup_size(128) fn rgb(@builtin(global_invocation_id) id:vec3<u32>){\n let word=id.x+id.y*p.groupsX*128u;let bytes=p.targetWidth*p.targetHeight*3u;\n if(word>=(bytes+3u)/4u){return;}var packed=0u;\n for(var lane=0u;lane<4u;lane++){\n  let at=word*4u+lane;if(at<bytes){let pixel=at/3u;let source=(pixel/p.targetWidth)*p.width+pixel%p.targetWidth;packed|=byte(input[source])<<(lane*8u);}\n }\n output[word]=packed;\n}";
