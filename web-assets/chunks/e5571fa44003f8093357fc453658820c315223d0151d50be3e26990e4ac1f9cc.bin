  }catch(error){failed=true;primary=error;throw error;}finally{try{await classicSiftRetireAll([()=>pool?.close(),()=>postPool?.close(),async()=>{if(returned||!options.state)await state.dispose();else for(const store of state.stores.values())store.markCold?.();}]);}catch(cleanup){if(returned&&releaseResult){const owner={close:releaseResult};keepClassicSiftRetirement(budget,owner);try{await releaseResult();forgetClassicSiftRetirement(budget,owner);}catch(retirement){attachClassicSiftCleanup(cleanup,retirement);}}if(failed)attachClassicSiftCleanup(primary,cleanup);else throw cleanup;}}
 }
}
