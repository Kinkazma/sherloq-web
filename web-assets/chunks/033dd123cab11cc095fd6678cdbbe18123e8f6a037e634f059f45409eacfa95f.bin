const normalized=input=>{requireValue(input?.schema===schema&&input.coordinates==='original-pixels'&&/^[a-f0-9]{64}$/.test(input.sourceSha256??'')&&Array.isArray(input.sourceGrid)&&input.sourceGrid.length===2&&input.sourceGrid.every(v=>Number.isSafeInteger(v)&&v>0),'Original comparison source identity required.');const roles=normalizedRoles(input.roles);for(const role of roles)if(role)requireValue(role.bounds[0]>=0&&role.bounds[1]>=0&&role.bounds[2]<=input.sourceGrid[0]&&role.bounds[3]<=input.sourceGrid[1],'Original comparison bounds exceed their source grid.');return{schema,coordinates:'original-pixels',sourceSha256:input.sourceSha256,sourceGrid:[...input.sourceGrid],roles};};
