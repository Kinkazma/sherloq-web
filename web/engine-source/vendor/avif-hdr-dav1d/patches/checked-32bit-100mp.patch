+{
+    if (!decoder || !decoder->data || !decoder->data->tiles.count) return 0;
+    const avifDecoderData * data = decoder->data;
+    if (data->source == AVIF_DECODER_SOURCE_TRACKS) return 1u + (data->tiles.count > 1u);
