+static uint64_t avifNativeCodecTileGeometry(const avifTile * tile, avifBool tileBudget)
+{
+    const uint64_t width = tile->width, height = tile->height;
+    if (!width || !height) return UINT64_MAX;
+    if (tileBudget) {
+        const uint64_t cols = AVIF_MIN(UINT64_C(64), (width + 63) / 64);
+        const uint64_t rows = AVIF_MIN(UINT64_C(64), (height + 63) / 64);
+        return cols * rows;
+    }
+    const uint64_t alignedWidth = (width + 127) & ~UINT64_C(127);
+    const uint64_t alignedHeight = (height + 127) & ~UINT64_C(127);
+    if (alignedHeight > UINT64_MAX / alignedWidth) return UINT64_MAX;
+    return alignedWidth * alignedHeight;
+}
+
+static uint64_t avifDecoderNativeCodecGeometry(const avifDecoder * decoder, avifBool tileBudget)
+{
+    if (!decoder || !decoder->data || !decoder->data->tiles.count) return 0;
+    const avifDecoderData * data = decoder->data;
+    const avifBool tracks = data->source == AVIF_DECODER_SOURCE_TRACKS;
+    const avifBool shared = !tracks && avifDecoderCanShareNativeCodec(decoder);
+    const uint32_t count = tracks ? AVIF_MIN(data->tiles.count, 2u) : data->tiles.count;
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint64_t value = avifNativeCodecTileGeometry(&data->tiles.tile[i], tileBudget);
+        if (value == UINT64_MAX) return UINT64_MAX;
+        if (shared) total = AVIF_MAX(total, value);
